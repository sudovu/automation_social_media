# ==============================================================================
# SOCIAL AUTOMATION HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Social Automation Hub"
SECRET_KEY=generate_a_random_32_byte_hex_or_base64_string_here_for_jwt
ENCRYPTION_KEY=your-32-url-safe-base64-fernet-key-here-must-be-32-bytes
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Database Configuration (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./social_hub.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/social_automation_hub
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/social_automation_hub

# Redis / Job Queue (Optional, fallback to built-in async task executor)
REDIS_URL=redis://localhost:6379/0

# Default Timezone & Business Hours
DEFAULT_TIMEZONE=UTC
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS="Monday,Tuesday,Wednesday,Thursday,Friday"

# AI Provider Configuration (mock, gemini, openai, anthropic, local)
AI_PROVIDER=mock
AI_API_KEY=""
AI_MODEL_NAME=gemini-1.5-flash
AI_DEFAULT_MODE=APPROVAL_REQUIRED

# Social Media OAuth & API Configurations (Optional per platform)
# Facebook & Instagram Graph API
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/facebook"

# X / Twitter API v2
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/twitter"

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/linkedin"

# YouTube / Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/google"

# TikTok for Developers
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/tiktok"

# Telegram Bot API
TELEGRAM_BOT_TOKEN=""

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="social_hub_verify_token"

# Reddit API
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/reddit"

# Pinterest API
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/pinterest"

# Threads API
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/threads"

# Safety & Anti-Spam Safeguards
MAX_MESSAGES_PER_HOUR=60
MAX_POSTS_PER_DAY=30
GLOBAL_COOLDOWN_SECONDS=10
AUTO_REPLY_LOOP_LIMIT=3

# Media Storage
MEDIA_UPLOAD_DIR="./media_storage"
MAX_UPLOAD_SIZE_MB=50
